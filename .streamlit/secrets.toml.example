# Copy to .streamlit/secrets.toml (local) or paste into Streamlit Community Cloud:
#   App -> Settings -> Secrets.  Never commit the real file.
# Every top-level key here becomes an environment variable for the app (same names as .env.example).

OPENROUTER_API_KEY = "sk-or-v1-..."

LLM_PROVIDER = "openrouter"
LLM_MODEL = "nvidia/nemotron-3-super-120b-a12b:free"
LLM_FALLBACK_MODELS = "google/gemma-4-31b-it:free,qwen/qwen3.8-27b:free"
LLM_PAID_FALLBACK_MODELS = ""
LLM_CONCURRENCY = "1"

RAG_ENABLED = "true"
EMBEDDING_MODEL = "nvidia/nemotron-3-embed-1b:free"
