# ---- Provider ----
# "openrouter" (default) or "mock" (keyword rules, to test the pipeline without an API key)
LLM_PROVIDER=openrouter
OPENROUTER_API_KEY=sk-or-v1-...
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Optional attribution shown on openrouter.ai
OPENROUTER_APP_NAME=TechRisk AI
OPENROUTER_SITE_URL=

# ---- Model ----
# Any id from https://openrouter.ai/models , e.g.
#   anthropic/claude-sonnet-5    (default: strong reasoning, 1M context, $2/$10 per M tokens)
#   anthropic/claude-opus-5.5    (highest quality, $4/$20)
#   google/gemini-3.8-flash      (fast/cheap, 1M context)
#   deepseek/deepseek-v4.1-flash (very cheap)
LLM_MODEL=anthropic/claude-sonnet-5
# Comma-separated models tried in order when the main model is rate-limited, busy or down.
# Keep these :free to never spend credits.
LLM_FALLBACK_MODELS=google/gemma-4-31b-it:free,qwen/qwen3.8-27b:free
# Used ONLY after all models above are blocked (e.g. the account-wide daily free limit).
# These cost credits; leave empty to never spend money (the run then stops with a clear message).
LLM_PAID_FALLBACK_MODELS=
# Seconds a rate-limited / failing model is skipped before it is tried again
MODEL_COOLDOWN_SECONDS=120
# Max seconds to wait for the per-minute free limit to reset before retrying
RATE_LIMIT_MAX_WAIT_SECONDS=65
# If every model in the chain is busy, wait up to this many seconds (total) for one to free up
CHAIN_MAX_WAIT_SECONDS=300
LLM_TEMPERATURE=0.1
LLM_TIMEOUT_SECONDS=300
# Request strict JSON output (auto-disabled for models that don't support it)
LLM_JSON_MODE=true

# ---- Context / size ----
# "auto" = read from the model's OpenRouter metadata. Set a number to override.
LLM_CONTEXT_TOKENS=auto
# Max tokens the model may generate per call (auto = min(8192, model limit))
LLM_MAX_OUTPUT_TOKENS=auto
# Tokens of document text per LLM call (auto = fits the context, capped by MAX_CHUNK_TOKENS)
CHUNK_TOKENS=auto
# Smaller chunks = more focused / thorough analysis; larger = fewer calls, more cross-section reasoning
MAX_CHUNK_TOKENS=30000
CHUNK_OVERLAP_TOKENS=300

# ---- Pipeline ----
# Parallel LLM calls
LLM_CONCURRENCY=4
# Drop risks whose evidence quote can't be found in the source (false = keep but flag them)
DROP_UNVERIFIED_RISKS=false

# ---- RAG (LangChain + Chroma vector DB) ----
RAG_ENABLED=true
# Embedding model on OpenRouter (list: https://openrouter.ai/api/v1/embeddings/models). Free default.
EMBEDDING_MODEL=nvidia/nemotron-3-embed-1b:free
# Persistent vector DB for the knowledge base (uploaded BRD/SRD are indexed in memory only, per run)
VECTOR_DB_DIR=data/chroma
# Folder of checklists / standards / lessons learned (.md .txt .pdf .docx), re-indexed when files change
KNOWLEDGE_BASE_DIR=knowledge_base
RAG_PIECE_CHARS=1500
RAG_PIECE_OVERLAP_CHARS=200
# Related pieces of the other document (BRD<->SRD) and knowledge-base pieces added to each analysis call
RAG_CROSS_DOC_K=6
RAG_KB_K=4
RAG_MIN_RELEVANCE=0.0
# Merge risks whose embeddings are this similar (0 = off). Calibrated for nemotron-3-embed-1b.
DEDUP_SIMILARITY=0.65
